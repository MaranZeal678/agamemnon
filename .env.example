# ─────────────────────────────────────────────────────────────────────────────
# Agamemnon — environment template
# Copy to .env and fill in NEBIUS_API_KEY yourself. Everything else is either
# a non-secret default or generated by `make setup` (database passwords).
# .env is gitignored; never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Nebius Token Factory (OpenAI-compatible) ────────────────────────────────
# Paste your key here yourself. It is never printed, logged, or committed.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/

# Model IDs — VERIFIED present on this account via GET /v1/models (2026-09-05).
# classifier: small MoE (3B active), cleanest strict-JSON, ~1.8s warm.
NEBIUS_CLASSIFIER_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# stock baseline for the eval comparison (a different untuned small model).
NEBIUS_STOCK_MODEL=google/gemma-3-27b-it
# narration + dataset generation (readable prose / quality generation).
NEBIUS_NARRATOR_MODEL=meta-llama/Llama-3.3-70B-Instruct
NEBIUS_DATASET_MODEL=meta-llama/Llama-3.3-70B-Instruct
# frontier model acting as judge in the eval.
NEBIUS_FRONTIER_MODEL=deepseek-ai/DeepSeek-V4-Pro

# Classifier feature flag. The write path never depends on the model: on timeout
# or error, a deterministic heuristic takes over. Timeout is the hard cap in ms;
# 800 is the brief's spec (small model runs ~1.8s, so the heuristic covers the
# live demo — the model's real latency is measured in the Act 4 eval instead).
CLASSIFIER_ENABLED=true
CLASSIFIER_TIMEOUT_MS=800

# ── Postgres (local Homebrew PostgreSQL 14 on port 5432 — no Docker) ────────
# Roles and database are created by `make setup` from these values.
# Passwords are machine-generated into .env by setup; regenerate any time
# with `make gen-creds && make setup`.
PGHOST=127.0.0.1
PGPORT=5432
MERIDIAN_DB=meridian

# Meridian Freight's own application credential.
# This is what the UNPROTECTED agent (Act 1) holds — the one that lets it
# destroy the loads table with nobody stopping it.
MERIDIAN_DB_USER=meridian_app
MERIDIAN_DB_PASSWORD=
MERIDIAN_DATABASE_URL=

# The credential ONLY Agamemnon holds. In Acts 2–3 this lives in a Convex
# environment variable; it appears here solely so setup can create the role.
AGAMEMNON_DB_USER=agamemnon_svc
AGAMEMNON_DB_PASSWORD=
AGAMEMNON_DATABASE_URL=

# ── Dispatch Copilot (the agent) ────────────────────────────────────────────
# false → Act 1: agent connects straight to Postgres with meridian_app.
# true  → Acts 2–3: agent has NO database password; every write goes through
#         the Agamemnon adapter. The agent's own .env files live in
#         packages/meridian/agent/ and are shown on screen during the demo.
AGAMEMNON_ENABLED=false

# Agamemnon ingest endpoint (the Convex HTTP Actions URL). Filled in during
# Phase 1 once your Convex dev deployment exists.
AGAMEMNON_PROPOSE_URL=
