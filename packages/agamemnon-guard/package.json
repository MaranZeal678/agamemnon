{
  "name": "agamemnon-guard",
  "version": "1.0.0",
  "description": "Agamemnon — write-path guardrail. Owns the data, enforces policy on every delete.",
  "productName": "Agamemnon",
  "author": "SquareShift",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "co.squareshift.agamemnon",
    "productName": "Agamemnon",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["electron/**/*", "app/**/*", "guard/**/*", "package.json"],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "artifactName": "Agamemnon-${version}-arm64.${ext}"
    },
    "dmg": { "title": "Agamemnon ${version}" }
  }
}
